@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ApiClient Api

<div class="app-shell">
    @if (AppSession.Token is not null)
    {
        <nav class="top-nav">
            <a href="/menu" class="top-nav-brand">POS-MB</a>
            <a href="/menu">Menu</a>
            <a href="/cart">Cart @(Cart.TotalItemCount > 0 ? $"({Cart.TotalItemCount})" : "")</a>
            <a href="/orders">My Orders</a>
            <button class="btn-link top-nav-logout" @onclick="Logout">Log Out</button>
        </nav>
    }

    <main class="app-content">
        @Body
    </main>
</div>

@code {
    private async Task Logout()
    {
        if (AppSession.RefreshToken is not null)
            await Api.LogoutAsync(AppSession.RefreshToken);

        AppSession.Clear();
        Cart.Clear();
        await AppSession.ClearPersistedAsync(Js);
        Nav.NavigateTo("/");
    }
}
