@page "/orders/{OrderId:int}"
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Order Detail - POS-MB</PageTitle>

@if (_loading)
{
    <p class="status-text">Loading order...</p>
}
else if (_order is null)
{
    <p>Order not found.</p>
}
else
{
    <h1>Order #@(_order.SerialNumber ?? _order.OrderId)</h1>
    <p>Date: @AppSession.ToLocalDisplay(_order.Date).ToString("yyyy-MM-dd HH:mm")</p>
    <p>Status: @_order.Status</p>

    <table class="order-items-table">
        <thead>
            <tr><th>Item</th><th>Qty</th><th>Line Total</th></tr>
        </thead>
        <tbody>
            @foreach (var line in _order.Items)
            {
                <tr>
                    <td>@ResolveItemName(line.ItemId)</td>
                    <td>@line.Quantity</td>
                    <td>@line.TotalItemsPrice.ToString("0.00") EGP</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="cart-total">
        @if (_order.ServiceFee > 0)
        {
            <div>Item Total: @_order.Total.ToString("0.00") EGP</div>
            <div>Service Fee: @_order.ServiceFee.ToString("0.00") EGP</div>
            <div class="cart-total-final">Total Charged: @((_order.Total + _order.ServiceFee).ToString("0.00")) EGP</div>
        }
        else
        {
            <div class="cart-total-final">Total: @_order.Total.ToString("0.00") EGP</div>
        }
    </div>

    @if (_order.Status == OrderStatus.AwaitingPayment)
    {
        <button class="btn btn-primary" @onclick="ResumeCheckout" disabled="@_resuming">
            @(_resuming ? "Please wait..." : "Complete Payment")
        </button>
    }

    @if (_order.Status == OrderStatus.Placed || _order.Status == OrderStatus.AwaitingPayment)
    {
        <button class="btn btn-danger" @onclick="CancelOrder" disabled="@_cancelling">
            @(_cancelling ? "Cancelling..." : "Cancel Order")
        </button>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="error-text">@_errorMessage</p>
    }
}

@code {
    private const string LastOrderIdKey = "last_placed_order_id";
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);

    [Parameter] public int OrderId { get; set; }

    private OrderDetailDto? _order;
    private Dictionary<int, string> _itemNamesById = [];
    private bool _loading = true;
    private bool _cancelling;
    private bool _resuming;
    private string? _errorMessage;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        if (AppSession.Token is null)
        {
            Nav.NavigateTo("/");
            return;
        }

        // includeInactive: true - a past order can reference an item that's
        // since gone unavailable or been retired, same reasoning as Mobile's
        // ApiClient.GetItemsAsync default for order-history name resolution.
        var itemsTask = Api.GetItemsAsync(includeInactive: true);
        _order = await Api.GetMyOrderAsync(OrderId);
        var items = await itemsTask;
        _itemNamesById = items.ToDictionary(i => i.ItemId, i => i.ItemName);

        _loading = false;
        StartPolling();
    }

    // Mirrors Mobile's OrderDetailPage polling - a student staring at this
    // page right after paying (or while the kitchen works on it) should see
    // status changes land on their own, not require a manual refresh.
    private void StartPolling()
    {
        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(PollInterval, token);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            if (token.IsCancellationRequested) return;

            OrderDetailDto? updated;
            try
            {
                updated = await Api.GetMyOrderAsync(OrderId);
            }
            catch (Exception)
            {
                continue; // transient blip - keep showing the last known state, try again next tick
            }

            if (updated is null || _order is null) continue;
            if (updated.Status == _order.Status && updated.Total == _order.Total) continue;

            _order = updated;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => _pollCts?.Cancel();

    private string ResolveItemName(int itemId) => _itemNamesById.GetValueOrDefault(itemId, $"Item #{itemId}");

    private async Task CancelOrder()
    {
        _errorMessage = null;
        _cancelling = true;
        try
        {
            var (success, error) = await Api.CancelOrderAsync(OrderId);
            if (!success)
            {
                _errorMessage = error;
                return;
            }

            _order = await Api.GetMyOrderAsync(OrderId);
        }
        finally
        {
            _cancelling = false;
        }
    }

    // Reoffers the saved card on retry too - a student who has one on file
    // almost certainly still wants to use it, same reasoning as Mobile's
    // OnContinuePaymentClicked.
    private async Task ResumeCheckout()
    {
        _errorMessage = null;
        _resuming = true;
        try
        {
            var useSavedCard = AppSession.CurrentStudent?.SavedCardMaskedPan is not null;
            var (checkoutUrl, alreadyPaid, error) = await Api.ResumeCheckoutAsync(OrderId, useSavedCard);

            // Not an error - the payment actually already succeeded (e.g. the
            // webhook landed while this page sat open) - same reasoning as
            // Mobile's own "Already Paid" handling.
            if (alreadyPaid)
            {
                _order = await Api.GetMyOrderAsync(OrderId);
                return;
            }

            if (checkoutUrl is null)
            {
                _errorMessage = error ?? "Could not resume checkout.";
                return;
            }

            await Js.InvokeVoidAsync("localStorage.setItem", LastOrderIdKey, OrderId.ToString());
            Nav.NavigateTo(checkoutUrl, forceLoad: true);
        }
        finally
        {
            _resuming = false;
        }
    }
}
