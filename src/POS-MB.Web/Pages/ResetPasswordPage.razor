@page "/reset-password"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Reset Password - POS-MB</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Reset Password</h1>
        <p class="status-text">Enter the code sent to @Email and choose a new password.</p>

        <div class="form-group">
            <label>6-digit code</label>
            <InputText @bind-Value="_code" class="form-control" placeholder="123456" />
        </div>
        <div class="form-group">
            <label>New password</label>
            <InputText @bind-Value="_newPassword" type="password" class="form-control" />
        </div>
        <div class="form-group">
            <label>Confirm password</label>
            <InputText @bind-Value="_confirmPassword" type="password" class="form-control" />
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="error-text">@_errorMessage</p>
        }
        @if (!string.IsNullOrEmpty(_infoMessage))
        {
            <p class="status-text">@_infoMessage</p>
        }

        <button class="btn btn-primary" @onclick="Reset" disabled="@_busy">
            @(_busy ? "Please wait..." : "Reset Password")
        </button>

        <button class="btn-link" @onclick="ResendCode" disabled="@_busy">Resend code</button>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }

    private string _code = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _errorMessage;
    private string? _infoMessage;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Email))
            Nav.NavigateTo("forgot-password");
    }

    private async Task Reset()
    {
        _errorMessage = null;
        _infoMessage = null;

        if (_code.Length != 6 || !_code.All(char.IsDigit))
        {
            _errorMessage = "Enter the 6-digit code from your email.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _errorMessage = "Enter a new password.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "Passwords don't match.";
            return;
        }

        _busy = true;
        try
        {
            var (success, error) = await Api.ResetPasswordAsync(Email!, _code, _newPassword);
            if (!success)
            {
                _errorMessage = error ?? "Something went wrong.";
                return;
            }

            // Same reasoning as logout - lands back at the login form, not
            // still-logged-in anywhere, since a password reset also revokes
            // every existing session server-side.
            Nav.NavigateTo("");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResendCode()
    {
        _busy = true;
        try
        {
            var (success, error) = await Api.ForgotPasswordAsync(Email!);
            _infoMessage = success ? "If that email is registered, a new code is on its way." : null;
            _errorMessage = success ? null : (error ?? "Something went wrong.");
        }
        finally
        {
            _busy = false;
        }
    }
}
