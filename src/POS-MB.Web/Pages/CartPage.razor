@page "/cart"
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Cart - POS-MB</PageTitle>

<h1>Your Cart</h1>

@if (Cart.Lines.Count == 0)
{
    <p>Your cart is empty.</p>
    <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("menu")'>Back to Menu</button>
}
else
{
    @foreach (var line in Cart.Lines)
    {
        <div class="cart-line">
            <div class="cart-line-main">
                <span class="cart-line-name">@line.ItemName</span>
                <span class="cart-line-price">@line.Subtotal.ToString("0.00") EGP</span>
            </div>
            <div class="cart-line-controls">
                <span>Qty: @line.Quantity</span>
                <button class="btn-link" @onclick="() => AddAnother(line)">+1</button>
                @if (_extraItems.Count > 0 && line.CanAddExtra)
                {
                    <button class="btn-link" @onclick="() => ToggleExtraPicker(line)">+ Extra</button>
                }
                <button class="btn-link" @onclick="() => OpenCommentEditor(line)">@(string.IsNullOrWhiteSpace(line.Comment) ? "Add Comment" : "Edit Comment")</button>
                <button class="btn-link" @onclick="() => RemoveLine(line)">Remove</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(line.Comment))
            {
                <div class="cart-line-extra"><span><em>@line.Comment</em></span></div>
            }

            @if (ReferenceEquals(_extraPickerLine, line))
            {
                <div class="cart-line-extra">
                    <select class="form-control" style="width:auto; display:inline-block;" @bind="_selectedExtraItemId">
                        @foreach (var extra in _extraItems)
                        {
                            <option value="@extra.ItemId">@extra.ItemName (@extra.Price.ToString("0.00") EGP)</option>
                        }
                    </select>
                    <button class="btn-link" style="display:inline; width:auto;" @onclick="() => AddExtra(line)">Add</button>
                    <button class="btn-link" style="display:inline; width:auto;" @onclick="() => _extraPickerLine = null">Cancel</button>
                </div>
            }

            @if (ReferenceEquals(_commentEditorLine, line))
            {
                <div class="cart-line-extra">
                    <input class="form-control" style="width:auto; display:inline-block;" maxlength="50" @bind="_commentDraft" placeholder="e.g. no onions" />
                    <button class="btn-link" style="display:inline; width:auto;" @onclick="() => SaveComment(line)">Save</button>
                    <button class="btn-link" style="display:inline; width:auto;" @onclick="() => _commentEditorLine = null">Cancel</button>
                </div>
            }

            @foreach (var extra in line.Extras)
            {
                <div class="cart-line-extra">
                    <span>+ @extra.ItemName (@extra.Subtotal.ToString("0.00") EGP)</span>
                    <button class="btn-link" @onclick="() => RemoveLine(extra)">Remove</button>
                </div>
            }
        </div>
    }

    <div class="cart-total">
        <div>Item Total: @Cart.Total.ToString("0.00") EGP</div>
        @if (_serviceFee > 0)
        {
            <div>Service Fee: @_serviceFee.ToString("0.00") EGP</div>
            <div class="cart-total-final">Total: @((Cart.Total + _serviceFee).ToString("0.00")) EGP</div>
        }
        else
        {
            <div class="cart-total-final">Total: @Cart.Total.ToString("0.00") EGP</div>
        }
    </div>

    @if (AppSession.CurrentStudent?.SavedCardMaskedPan is string maskedPan)
    {
        <div class="form-group">
            <label>
                <input type="checkbox" @bind="_useSavedCard" />
                @(AppSession.CurrentStudent?.SavedCardSubtype is string subtype
                    ? $"Pay with saved {subtype} {maskedPan}"
                    : $"Pay with saved card {maskedPan}")
            </label>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="error-text">@_errorMessage</p>
    }

    <button class="btn btn-primary" @onclick="PlaceOrder" disabled="@_placing">
        @(_placing ? "Placing order..." : "Place Order")
    </button>
}

@code {
    private const string LastOrderIdKey = "last_placed_order_id";

    // Matches the cashier side's and Mobile's own copy of this key - the
    // setting that marks which category's items show up behind a cart
    // line's "+Extra" button.
    private const string ExtrasCategorySettingKey = "ExtrasCategoryId";

    private string? _errorMessage;
    private bool _placing;
    private decimal _serviceFee;
    private bool _useSavedCard;
    private List<ItemDto> _extraItems = [];
    private CartLine? _extraPickerLine;
    private int _selectedExtraItemId;
    private CartLine? _commentEditorLine;
    private string _commentDraft = "";

    protected override async Task OnInitializedAsync()
    {
        if (AppSession.Token is null)
        {
            Nav.NavigateTo("");
            return;
        }

        var feeValue = await Api.GetSettingValueAsync("MobileOrderServiceFee");
        _serviceFee = feeValue is not null
            && decimal.TryParse(feeValue, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var fee)
                ? fee
                : 0m;

        var extrasCategoryValue = await Api.GetSettingValueAsync(ExtrasCategorySettingKey);
        _extraItems = int.TryParse(extrasCategoryValue, out var categoryId)
            ? await Api.GetItemsAsync(categoryId)
            : [];
    }

    private void AddAnother(CartLine line) => Cart.AddAnother(line);
    private void RemoveLine(CartLine line) => Cart.Remove(line);

    // An extra always attaches to the ONE specific line it was requested
    // for, not to the cart generally - same reasoning as Mobile's
    // OnAddExtraClicked (see Session/Cart.cs's AddExtra).
    private void ToggleExtraPicker(CartLine line)
    {
        _commentEditorLine = null;
        if (ReferenceEquals(_extraPickerLine, line))
        {
            _extraPickerLine = null;
            return;
        }

        _extraPickerLine = line;
        _selectedExtraItemId = _extraItems[0].ItemId;
    }

    private void AddExtra(CartLine line)
    {
        var extraItem = _extraItems.FirstOrDefault(i => i.ItemId == _selectedExtraItemId);
        if (extraItem is not null)
            Cart.AddExtra(line, extraItem);

        _extraPickerLine = null;
    }

    private void OpenCommentEditor(CartLine line)
    {
        _extraPickerLine = null;
        _commentEditorLine = line;
        _commentDraft = line.Comment ?? "";
    }

    private void SaveComment(CartLine line)
    {
        line.Comment = string.IsNullOrWhiteSpace(_commentDraft) ? null : _commentDraft.Trim();
        _commentEditorLine = null;
    }

    private async Task PlaceOrder()
    {
        _errorMessage = null;
        _placing = true;
        try
        {
            var items = Cart.Flattened.Select(l => new OrderItemLineDto(l.ItemId, l.Quantity, l.Comment)).ToList();
            var useSavedCard = AppSession.CurrentStudent?.SavedCardMaskedPan is not null && _useSavedCard;
            var (result, error, unavailableItems) = await Api.PlaceOrderAsync(items, useSavedCard);

            if (result is null)
            {
                _errorMessage = error ?? "Something went wrong.";
                if (unavailableItems.Count > 0)
                    Cart.RemoveAllWhere(l => unavailableItems.Any(u => u.ItemId == l.ItemId));
                return;
            }

            Cart.Clear();

            // Stashed so PaymentCompletePage knows which order to show once
            // Paymob redirects back - the real status still only ever comes
            // from the server (see that page's own comment), this is purely
            // "which order was this" continuity across the redirect.
            await Js.InvokeVoidAsync("localStorage.setItem", LastOrderIdKey, result.OrderId.ToString());

            if (result.CheckoutUrl is not null)
                Nav.NavigateTo(result.CheckoutUrl, forceLoad: true); // external redirect to Paymob's hosted checkout
            else
                Nav.NavigateTo($"orders/{result.OrderId}");
        }
        finally
        {
            _placing = false;
        }
    }
}
