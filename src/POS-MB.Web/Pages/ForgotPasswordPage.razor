@page "/forgot-password"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Forgot Password - POS-MB</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Reset Your Password</h1>

        <div class="form-group">
            <label>Email</label>
            <InputText @bind-Value="_email" class="form-control" placeholder="you@example.com" />
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="error-text">@_errorMessage</p>
        }

        <button class="btn btn-primary" @onclick="SendCode" disabled="@_busy">
            @(_busy ? "Please wait..." : "Send Reset Code")
        </button>

        <button class="btn-link" @onclick='() => Nav.NavigateTo("/")'>Back to Log In</button>
    </div>
</div>

@code {
    private string _email = "";
    private string? _errorMessage;
    private bool _busy;

    private async Task SendCode()
    {
        _errorMessage = null;
        var email = _email.Trim();

        if (string.IsNullOrWhiteSpace(email))
        {
            _errorMessage = "Enter your email.";
            return;
        }

        _busy = true;
        try
        {
            var (success, error) = await Api.ForgotPasswordAsync(email);
            if (!success)
            {
                _errorMessage = error ?? "Something went wrong.";
                return;
            }

            // The server always returns success here regardless of whether
            // the email actually matched an account - never reveal that
            // from the client either, same reasoning as
            // clsStudentBusiness.RequestPasswordResetAsync.
            Nav.NavigateTo($"/reset-password?email={Uri.EscapeDataString(email)}");
        }
        finally
        {
            _busy = false;
        }
    }
}
