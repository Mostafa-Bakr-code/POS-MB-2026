<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Cashier.Pages.TextInputPage">

    <VerticalStackLayout Padding="20" Spacing="10" VerticalOptions="Center">
        <Label x:Name="PromptLabel" FontAttributes="Bold" />
        <Entry x:Name="ValueEntry" Completed="OnSaveClicked" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,14,0,0">
            <Button Grid.Column="0" Text="Save" Clicked="OnSaveClicked" BackgroundColor="#198754" TextColor="White" FontAttributes="Bold" />
            <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" />
        </Grid>
    </VerticalStackLayout>

</ContentPage>
