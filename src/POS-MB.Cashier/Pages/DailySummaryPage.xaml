<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POS_MB.Cashier.Controls"
             x:Class="POS_MB.Cashier.Pages.DailySummaryPage"
             Title="Daily Summary">

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">

        <FlexLayout Grid.Row="0" Direction="Row" Wrap="Wrap" AlignItems="Center">
            <Label x:Name="DateLabel" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" Margin="0,0,16,8" />
            <Button Text="Refresh" Clicked="OnRefreshClicked" FontAttributes="Bold" Margin="0,0,10,8" />
            <Button x:Name="ExportButton" Text="Export to Excel" Clicked="OnExportClicked" Margin="0,0,0,8" />
        </FlexLayout>

        <controls:DataGridView x:Name="SummaryGrid" Grid.Row="1" />

    </Grid>

</ContentPage>
