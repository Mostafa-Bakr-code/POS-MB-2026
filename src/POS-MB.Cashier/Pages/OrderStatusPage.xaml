<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POS_MB.Cashier.Controls"
             x:Class="POS_MB.Cashier.Pages.OrderStatusPage"
             Title="Order Status">

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">

        <FlexLayout Grid.Row="0" Direction="Row" Wrap="Wrap" AlignItems="Center">
            <HorizontalStackLayout Spacing="8" Margin="0,0,16,8">
                <Switch x:Name="ShowAllSwitch" Toggled="OnShowAllToggled" />
                <Label Text="Show Completed/Cancelled Too" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="Refresh" Clicked="OnRefreshClicked" FontAttributes="Bold" Margin="0,0,16,8" />

            <HorizontalStackLayout Spacing="8" Margin="0,0,0,8">
                <Switch x:Name="AcceptingOrdersSwitch" Toggled="OnAcceptingOrdersToggled" />
                <Label Text="Accepting Online Orders" VerticalOptions="Center" FontAttributes="Bold" />
            </HorizontalStackLayout>
        </FlexLayout>

        <controls:DataGridView x:Name="OrdersGrid" Grid.Row="1" />

    </Grid>

</ContentPage>
