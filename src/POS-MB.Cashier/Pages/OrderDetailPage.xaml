<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POS_MB.Cashier.Controls"
             x:Class="POS_MB.Cashier.Pages.OrderDetailPage">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="10">
        <Label x:Name="HeaderLabel" Grid.Row="0" LineBreakMode="WordWrap" />
        <controls:DataGridView x:Name="LinesGrid" Grid.Row="1" />
        <Button Grid.Row="2" Text="Close" Clicked="OnCloseClicked" FontAttributes="Bold" />
    </Grid>

</ContentPage>
