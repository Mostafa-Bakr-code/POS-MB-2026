<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Cashier.Pages.MainShellPage"
             Title="POS-MB"
             BackgroundColor="#212529">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <FlexLayout
                x:Name="NavButtonsLayout"
                Grid.Column="0"
                Direction="Row"
                Wrap="Wrap"
                JustifyContent="Start" />

            <VerticalStackLayout Grid.Column="1" WidthRequest="160" Spacing="4">
                <Button x:Name="LogoutButton" Text="Log Out" Clicked="OnLogoutClicked" BackgroundColor="#B02A37" TextColor="White" />
                <Label x:Name="ActiveUserLabel" TextColor="White" HorizontalTextAlignment="Center" FontAttributes="Bold" />
                <Label x:Name="PrintStatusLabel" TextColor="#B4BEC8" HorizontalTextAlignment="Center" FontSize="11" />
            </VerticalStackLayout>
        </Grid>

        <Frame Grid.Row="1" BackgroundColor="White" Padding="30" CornerRadius="8">
            <Label
                Text="Pick a screen above."
                HorizontalOptions="Center"
                VerticalOptions="Center"
                FontSize="16" />
        </Frame>

    </Grid>

</ContentPage>
