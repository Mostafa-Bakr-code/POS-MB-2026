<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Cashier.Pages.CategoryEditPage">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Label Text="Category Name" FontAttributes="Bold" />
        <!-- MaxLength 20 - matches Categories.CategoryName NVARCHAR(20) in schema.sql. -->
        <Entry x:Name="NameEntry" MaxLength="20" />

        <Label Text="Photo" FontAttributes="Bold" Margin="0,10,0,0" />
        <Frame WidthRequest="120" HeightRequest="120" Padding="0" HorizontalOptions="Start" BackgroundColor="#F5F5F5" BorderColor="#DDDDDD">
            <Image x:Name="PreviewImage" Aspect="AspectFit" />
        </Frame>

        <Button x:Name="ChooseImageButton" Text="Choose Image..." Clicked="OnChooseImageClicked" />
        <Button x:Name="RemoveImageButton" Text="Remove Photo" Clicked="OnRemoveImageClicked" />

        <BoxView HeightRequest="1" BackgroundColor="#DDDDDD" Margin="0,10,0,0" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
            <Button Grid.Column="0" Text="Save" Clicked="OnSaveClicked" BackgroundColor="#198754" TextColor="White" FontAttributes="Bold" />
            <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" />
        </Grid>

    </VerticalStackLayout>

</ContentPage>
