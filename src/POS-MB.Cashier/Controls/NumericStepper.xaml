<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Cashier.Controls.NumericStepper">

    <Grid ColumnDefinitions="44,*,44" ColumnSpacing="4">
        <Button Grid.Column="0" Text="-" Clicked="OnDecrementClicked" FontAttributes="Bold" Padding="0" />

        <Entry
            x:Name="ValueEntry"
            Grid.Column="1"
            Keyboard="Numeric"
            HorizontalTextAlignment="Center"
            TextChanged="OnEntryTextChanged"
            Unfocused="OnEntryUnfocused" />

        <Button Grid.Column="2" Text="+" Clicked="OnIncrementClicked" FontAttributes="Bold" Padding="0" />
    </Grid>

</ContentView>
