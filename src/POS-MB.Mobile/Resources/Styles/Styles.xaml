    <!-- Navy canvas always - a deliberate single identity (see Colors.xaml),
         so Light and Dark both bind the same value rather than adapting. -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource AppBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource AppBackgroundDeep}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource TextOnDarkMuted}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource TextOnDarkMuted}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource AppBackgroundDeep}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Yellow}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Yellow}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextOnDarkMuted}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource AppBackgroundDeep}" />
        <Setter Property="BarTextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="IconColor" Value="{StaticResource TextOnDark}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource AppBackgroundDeep}" />
        <Setter Property="BarTextColor" Value="{StaticResource Yellow}" />
        <Setter Property="UnselectedTabColor" Value="{StaticResource TextOnDarkMuted}" />
        <Setter Property="SelectedTabColor" Value="{StaticResource Yellow}" />
    </Style>

</ResourceDictionary>
