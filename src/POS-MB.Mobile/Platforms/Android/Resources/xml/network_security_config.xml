<?xml version="1.0" encoding="utf-8"?>
<!-- Android blocks plain HTTP by default (API 28+) - this app talks to a
     local dev API over plain HTTP on the LAN (see ApiConfig.BaseUrl), not a
     real deployed server, so only this one specific IP is exempted rather
     than allowing cleartext traffic broadly. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.3</domain>
    </domain-config>
</network-security-config>
