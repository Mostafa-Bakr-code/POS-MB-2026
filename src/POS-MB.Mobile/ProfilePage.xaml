<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Mobile.ProfilePage"
             Title="Account">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home" Clicked="OnHomeClicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="16" Spacing="16">

        <Label
            x:Name="EmailLabel"
            FontSize="16"
            FontAttributes="Bold" />

        <BoxView HeightRequest="1" Color="LightGray" />

        <Label
            Text="Payment"
            FontSize="14"
            TextColor="Gray" />

        <Label
            x:Name="NoCardLabel"
            Text="No saved card. Check &quot;Pay with saved card&quot; during checkout to save one for next time."
            TextColor="Gray"
            IsVisible="False" />

        <Grid x:Name="CardLayout" ColumnDefinitions="*,Auto" IsVisible="False">
            <Label Grid.Column="0" x:Name="CardLabel" VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                x:Name="RemoveCardButton"
                Text="Remove"
                Clicked="OnRemoveCardClicked"
                BackgroundColor="Transparent"
                TextColor="Red" />
        </Grid>

        <Label
            x:Name="ErrorLabel"
            TextColor="Red"
            IsVisible="False" />

        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />

    </VerticalStackLayout>

</ContentPage>
