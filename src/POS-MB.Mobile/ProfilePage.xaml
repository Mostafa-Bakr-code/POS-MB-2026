<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Mobile.ProfilePage"
             Title="Account">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home" Clicked="OnHomeClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="16">

            <Label
                x:Name="EmailLabel"
                FontSize="17"
                FontAttributes="Bold" />

            <BoxView HeightRequest="1" Color="{StaticResource ChipInactive}" />

            <Label
                Text="PAYMENT"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="{StaticResource TextOnDarkMuted}" />

            <Label
                x:Name="NoCardLabel"
                Text="No saved card. Check &quot;Pay with saved card&quot; during checkout to save one for next time."
                TextColor="{StaticResource TextOnDarkMuted}"
                IsVisible="False" />

            <Frame x:Name="CardLayout" Padding="14,12" CornerRadius="16" HasShadow="False" BackgroundColor="{StaticResource CardSurface}" BorderColor="Transparent" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" x:Name="CardLabel" TextColor="{StaticResource TextOnCard}" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        x:Name="RemoveCardButton"
                        Text="Remove"
                        Clicked="OnRemoveCardClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Coral}"
                        FontSize="13"
                        Padding="0"
                        MinimumHeightRequest="0" />
                </Grid>
            </Frame>

            <Label
                x:Name="ErrorLabel"
                TextColor="{StaticResource ErrorRed}"
                IsVisible="False" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />

            <BoxView HeightRequest="1" Color="{StaticResource ChipInactive}" />

            <Label
                Text="CHANGE PASSWORD"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="{StaticResource TextOnDarkMuted}" />

            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="4">
                <Entry
                    x:Name="CurrentPasswordEntry"
                    Placeholder="Current password"
                    IsPassword="True" />
            </Border>

            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="4">
                <Entry
                    x:Name="NewPasswordEntry"
                    Placeholder="New password"
                    IsPassword="True" />
            </Border>

            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="4">
                <Entry
                    x:Name="ConfirmPasswordEntry"
                    Placeholder="Confirm new password"
                    IsPassword="True" />
            </Border>

            <Label
                x:Name="PasswordErrorLabel"
                TextColor="{StaticResource ErrorRed}"
                IsVisible="False" />

            <ActivityIndicator x:Name="PasswordLoadingIndicator" IsRunning="False" IsVisible="False" />

            <Button
                x:Name="ChangePasswordButton"
                Text="Change Password"
                Clicked="OnChangePasswordClicked"
                HeightRequest="52"
                FontSize="16" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
