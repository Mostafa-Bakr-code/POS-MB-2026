<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:session="clr-namespace:POS_MB.Mobile.Session"
             x:Class="POS_MB.Mobile.CartPage"
             Title="Your Cart">

    <Grid RowDefinitions="*,Auto,Auto,Auto" Padding="16" RowSpacing="12">

        <CollectionView Grid.Row="0" x:Name="CartView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="session:CartLine">
                    <Grid Padding="0,10" ColumnDefinitions="*,Auto,Auto,Auto">
                        <Label Grid.Column="0" Text="{Binding ItemName}" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="16" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="2" Text="{Binding Subtotal, StringFormat='{0:0.00}'}" FontSize="16" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="3" Text="Remove" Clicked="OnRemoveClicked" BackgroundColor="Transparent" TextColor="Red" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            Grid.Row="1"
            x:Name="TotalLabel"
            FontSize="18"
            FontAttributes="Bold"
            HorizontalOptions="End" />

        <Label
            Grid.Row="2"
            x:Name="ErrorLabel"
            TextColor="Red"
            IsVisible="False" />

        <Button
            Grid.Row="3"
            x:Name="PlaceOrderButton"
            Text="Place Order"
            Clicked="OnPlaceOrderClicked" />

    </Grid>

</ContentPage>
