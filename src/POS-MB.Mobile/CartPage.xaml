<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:session="clr-namespace:POS_MB.Mobile.Session"
             x:Class="POS_MB.Mobile.CartPage"
             Title="Your Cart">

    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto" Padding="16" RowSpacing="12">

        <CollectionView Grid.Row="0" x:Name="CartView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="session:CartLine">
                    <VerticalStackLayout Spacing="2" Padding="0,10">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <Label Grid.Column="0" Text="{Binding ItemName}" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='{0:0.00}'}" FontSize="16" VerticalOptions="Center" Margin="0,0,12,0" />
                            <Button Grid.Column="2" Text="+1" WidthRequest="44" Clicked="OnAddAnotherClicked" />
                            <Button Grid.Column="3" Text="Remove" Clicked="OnRemoveClicked" BackgroundColor="Transparent" TextColor="Red" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding DisplayComment}" TextColor="{Binding CommentTextColor}" FontSize="13" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{Binding CommentButtonText}" Clicked="OnCommentClicked" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            Grid.Row="1"
            x:Name="TotalLabel"
            FontSize="18"
            FontAttributes="Bold"
            HorizontalOptions="End" />

        <Grid
            Grid.Row="2"
            x:Name="SavedCardLayout"
            ColumnDefinitions="Auto,*"
            IsVisible="False">
            <CheckBox Grid.Column="0" x:Name="SavedCardCheckBox" />
            <Label
                Grid.Column="1"
                x:Name="SavedCardLabel"
                VerticalOptions="Center" />
        </Grid>

        <Label
            Grid.Row="3"
            x:Name="ErrorLabel"
            TextColor="Red"
            IsVisible="False" />

        <Button
            Grid.Row="4"
            x:Name="PlaceOrderButton"
            Text="Place Order"
            Clicked="OnPlaceOrderClicked" />

    </Grid>

</ContentPage>
