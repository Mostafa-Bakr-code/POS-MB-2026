<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:POS_MB.Mobile.Models"
             xmlns:local="clr-namespace:POS_MB.Mobile"
             x:Class="POS_MB.Mobile.OrdersPage"
             Title="My Orders">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home" Clicked="OnHomeClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="20,14,20,14" RowSpacing="12">

        <Label
            Grid.Row="0"
            x:Name="PlaceholderLabel"
            Text="No orders yet"
            TextColor="{StaticResource TextOnDarkMuted}"
            HorizontalOptions="Center"
            IsVisible="False" />

        <RefreshView Grid.Row="1" x:Name="OrdersRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="OrdersView" IsGrouped="True" SelectionMode="Single" SelectionChanged="OnOrderSelected">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="local:OrderGroup">
                        <Label
                            Text="{Binding Label}"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="{StaticResource Yellow}"
                            Padding="4,10,4,4" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:OrderSummaryDto">
                        <Frame Padding="14,12" Margin="0,0,0,10" CornerRadius="16" HasShadow="False" BackgroundColor="{StaticResource CardSurface}" BorderColor="Transparent">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="{Binding SerialNumber, StringFormat='#{0}'}" TextColor="{StaticResource TextOnCard}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Date, StringFormat='{0:HH:mm}'}" TextColor="{StaticResource TextOnCardMuted}" VerticalOptions="Center" />
                                <Frame Grid.Column="2" Padding="8,3" CornerRadius="10" HasShadow="False" BackgroundColor="#FFF3D6" BorderColor="Transparent" VerticalOptions="Center">
                                    <Label Text="{Binding Status}" TextColor="{StaticResource TextOnCard}" FontSize="11" FontAttributes="Bold" />
                                </Frame>
                                <Label Grid.Column="3" Text="{Binding Total, StringFormat='{0:0.00}'}" TextColor="{StaticResource Coral}" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
