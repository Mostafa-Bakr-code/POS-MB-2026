<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:POS_MB.Mobile.Models"
             x:Class="POS_MB.Mobile.MenuPage"
             Title="Menu">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <Label
            Grid.Row="0"
            x:Name="WelcomeLabel"
            FontSize="18"
            FontAttributes="Bold" />

        <CollectionView
            Grid.Row="1"
            x:Name="CategoriesView"
            SelectionMode="Single"
            SelectionChanged="OnCategorySelected"
            HeightRequest="50">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CategoryDto">
                    <Frame Padding="14,8" CornerRadius="18" BackgroundColor="{StaticResource Primary}">
                        <Label Text="{Binding CategoryName}" TextColor="White" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <RefreshView Grid.Row="2" x:Name="ItemsRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="ItemsView">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ItemDto">
                        <Grid Padding="0,10" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding ItemName}" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:0.00}'}" FontSize="16" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
