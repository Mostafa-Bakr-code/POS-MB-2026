<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:POS_MB.Mobile.Models"
             x:Class="POS_MB.Mobile.MenuPage"
             Title="Menu">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="20,16,20,16" RowSpacing="14">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <Label
                Grid.Column="0"
                x:Name="WelcomeLabel"
                FontSize="19"
                FontAttributes="Bold"
                VerticalOptions="Center"
                LineBreakMode="TailTruncation" />
            <Button
                Grid.Column="1"
                Text="Account"
                Clicked="OnAccountClicked"
                BackgroundColor="{StaticResource ChipInactive}"
                TextColor="{StaticResource TextOnDark}"
                FontSize="12"
                CornerRadius="18"
                Padding="12,8"
                MinimumHeightRequest="36" />
            <Button
                Grid.Column="2"
                Text="Orders"
                Clicked="OnMyOrdersClicked"
                BackgroundColor="{StaticResource ChipInactive}"
                TextColor="{StaticResource TextOnDark}"
                FontSize="12"
                CornerRadius="18"
                Padding="12,8"
                MinimumHeightRequest="36" />
            <Button
                Grid.Column="3"
                Text="Log Out"
                Clicked="OnLogoutClicked"
                BackgroundColor="{StaticResource ChipInactive}"
                TextColor="{StaticResource Coral}"
                FontSize="12"
                CornerRadius="18"
                Padding="12,8"
                MinimumHeightRequest="36" />
        </Grid>

        <Label
            Grid.Row="1"
            x:Name="NotAcceptingOrdersBanner"
            Text="Not accepting online orders right now - please check back later."
            TextColor="{StaticResource TextOnDark}"
            BackgroundColor="{StaticResource CoralDeep}"
            Padding="14,10"
            FontAttributes="Bold"
            FontSize="13"
            IsVisible="False">
            <Label.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="12" Offset="0,4" />
            </Label.Shadow>
        </Label>

        <CollectionView
            Grid.Row="2"
            x:Name="CategoriesView"
            SelectionMode="Single"
            SelectionChanged="OnCategorySelected"
            HeightRequest="64">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CategoryDto">
                    <Frame
                        Padding="8,0,16,0"
                        CornerRadius="28"
                        HeightRequest="56"
                        HasShadow="False"
                        BackgroundColor="{StaticResource ChipInactive}"
                        BorderColor="Transparent">
                        <Frame.VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource Yellow}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </Frame.VisualStateManager.VisualStateGroups>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Frame
                                WidthRequest="42"
                                HeightRequest="42"
                                Padding="0"
                                CornerRadius="21"
                                HasShadow="False"
                                BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                IsClippedToBounds="True"
                                VerticalOptions="Center"
                                IsVisible="{Binding HasImage}">
                                <Image Source="{Binding FullImageUrl}" Aspect="AspectFill" />
                            </Frame>
                            <Label
                                Text="{Binding CategoryName}"
                                TextColor="{StaticResource TextOnDark}"
                                FontAttributes="Bold"
                                FontSize="13"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center">
                                <Label.VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="TextColor" Value="{StaticResource TextOnCard}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </Label.VisualStateManager.VisualStateGroups>
                            </Label>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3">
            <Label
                x:Name="PlaceholderLabel"
                Text="Pick a category above to see its items"
                TextColor="{StaticResource TextOnDarkMuted}"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,30,0,0" />

            <RefreshView x:Name="ItemsRefreshView" Refreshing="OnRefreshing">
                <CollectionView x:Name="ItemsView">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ItemDto">
                            <Frame
                                Padding="10"
                                CornerRadius="20"
                                HasShadow="False"
                                BackgroundColor="{StaticResource CardSurface}"
                                BorderColor="Transparent">
                                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">

                                    <!-- Real photo when the item has one; falls back to an
                                         initial-letter "avatar" otherwise - reads far
                                         better than an empty box for items nobody's
                                         uploaded a picture for yet. -->
                                    <Frame
                                        Grid.Column="0"
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        Padding="0"
                                        CornerRadius="16"
                                        HasShadow="False"
                                        BackgroundColor="#FFE7EE"
                                        BorderColor="Transparent"
                                        IsClippedToBounds="True"
                                        VerticalOptions="Center">
                                        <Grid>
                                            <Image
                                                Source="{Binding FullImageUrl}"
                                                Aspect="AspectFill"
                                                IsVisible="{Binding HasImage}" />
                                            <Label
                                                Text="{Binding ItemName, Converter={StaticResource FirstLetterConverter}}"
                                                TextColor="{StaticResource Coral}"
                                                FontAttributes="Bold"
                                                FontSize="20"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding HasNoImage}" />
                                        </Grid>
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding ItemName}"
                                            TextColor="{Binding NameTextColor}"
                                            FontAttributes="Bold"
                                            FontSize="15" />
                                        <Label
                                            Text="{Binding Description}"
                                            TextColor="{StaticResource TextOnCardMuted}"
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            IsVisible="{Binding HasDescription}" />
                                        <Label
                                            Text="Currently Unavailable"
                                            TextColor="{StaticResource TextOnCardMuted}"
                                            FontSize="12"
                                            IsVisible="{Binding IsUnavailable}" />
                                        <Label
                                            Text="{Binding Price, StringFormat='EGP {0:0.00}'}"
                                            TextColor="{StaticResource Coral}"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            IsVisible="{Binding IsAvailable}" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="2"
                                        Text="+"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        Padding="0"
                                        CornerRadius="12"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        BackgroundColor="{StaticResource TextOnCard}"
                                        TextColor="{StaticResource Yellow}"
                                        VerticalOptions="Center"
                                        Clicked="OnAddToCartClicked"
                                        IsVisible="{Binding IsAvailable}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <Button
            Grid.Row="4"
            x:Name="CartButton"
            Clicked="OnCartClicked"
            IsEnabled="False"
            HeightRequest="54"
            FontSize="16" />

    </Grid>

</ContentPage>
