<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Mobile.ResetPasswordPage"
             Title="Reset Password">

    <ScrollView>
        <VerticalStackLayout Padding="30,40,30,30" Spacing="16">

            <Label
                x:Name="InstructionsLabel"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False" />

            <Entry
                x:Name="CodeEntry"
                Placeholder="6-digit code"
                Keyboard="Numeric"
                MaxLength="6" />

            <Entry
                x:Name="NewPasswordEntry"
                Placeholder="New password"
                IsPassword="True" />

            <Entry
                x:Name="ConfirmPasswordEntry"
                Placeholder="Confirm new password"
                IsPassword="True" />

            <Label
                x:Name="ErrorLabel"
                TextColor="Red"
                IsVisible="False" />

            <Button
                x:Name="ResetButton"
                Text="Reset Password"
                Clicked="OnResetClicked"
                Margin="0,10,0,0" />

            <Button
                x:Name="ResendCodeButton"
                Text="Didn't get a code? Send again"
                Clicked="OnResendCodeClicked"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
