<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Mobile.ResetPasswordPage"
             Title="Reset Password">

    <ScrollView>
        <VerticalStackLayout Padding="30,40,30,30" Spacing="16">

            <Label
                x:Name="InstructionsLabel"
                TextColor="{StaticResource TextOnDarkMuted}"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False" />

            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="4">
                <Entry
                    x:Name="CodeEntry"
                    Placeholder="6-digit code"
                    Keyboard="Numeric"
                    MaxLength="6" />
            </Border>

            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="4">
                <Entry
                    x:Name="NewPasswordEntry"
                    Placeholder="New password"
                    IsPassword="True" />
            </Border>

            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="4">
                <Entry
                    x:Name="ConfirmPasswordEntry"
                    Placeholder="Confirm new password"
                    IsPassword="True" />
            </Border>

            <Label
                x:Name="ErrorLabel"
                TextColor="{StaticResource ErrorRed}"
                IsVisible="False" />

            <Button
                x:Name="ResetButton"
                Text="Reset Password"
                Clicked="OnResetClicked"
                HeightRequest="52"
                FontSize="16"
                Margin="0,10,0,0" />

            <Button
                x:Name="ResendCodeButton"
                Text="Didn't get a code? Send again"
                Clicked="OnResendCodeClicked"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Yellow}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
