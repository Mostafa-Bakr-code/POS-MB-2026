<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:POS_MB.Mobile.Models"
             x:Class="POS_MB.Mobile.OrderDetailPage"
             Title="Order Details">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home" Clicked="OnHomeClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16" RowSpacing="12">

        <Label
            Grid.Row="0"
            x:Name="HeaderLabel"
            FontSize="16" />

        <CollectionView Grid.Row="1" x:Name="ItemsView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OrderItemDisplayDto">
                    <VerticalStackLayout Spacing="2" Padding="0,10">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" Text="{Binding ItemName}" FontSize="16" />
                            <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="16" Margin="0,0,12,0" />
                            <Label Grid.Column="2" Text="{Binding TotalItemsPrice, StringFormat='{0:0.00}'}" FontSize="16" />
                        </Grid>
                        <Label Text="{Binding Comment}" IsVisible="{Binding HasComment}" TextColor="Gray" FontSize="13" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="2"
            x:Name="ContinuePaymentButton"
            Text="Continue to Payment"
            BackgroundColor="Green"
            TextColor="White"
            Clicked="OnContinuePaymentClicked"
            IsVisible="False" />

        <Button
            Grid.Row="3"
            x:Name="CancelButton"
            Text="Cancel Order"
            BackgroundColor="Red"
            TextColor="White"
            Clicked="OnCancelClicked"
            IsVisible="False" />

    </Grid>

</ContentPage>
