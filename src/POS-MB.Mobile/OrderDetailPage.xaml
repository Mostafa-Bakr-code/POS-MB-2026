<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:POS_MB.Mobile.Models"
             x:Class="POS_MB.Mobile.OrderDetailPage"
             Title="Order Details">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home" Clicked="OnHomeClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20,16,20,16" RowSpacing="12">

        <Frame Grid.Row="0" Padding="16,14" CornerRadius="18" HasShadow="False" BackgroundColor="{StaticResource CardSurface}" BorderColor="Transparent">
            <Label
                x:Name="HeaderLabel"
                TextColor="{StaticResource TextOnCard}"
                FontSize="15" />
        </Frame>

        <CollectionView Grid.Row="1" x:Name="ItemsView">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OrderItemDisplayDto">
                    <Frame Padding="14,10" Margin="0,10,0,0" CornerRadius="16" HasShadow="False" BackgroundColor="{StaticResource CardSurface}" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Grid.Column="0" Text="{Binding ItemName}" TextColor="{StaticResource TextOnCard}" FontAttributes="Bold" FontSize="15" />
                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" TextColor="{StaticResource TextOnCardMuted}" FontSize="14" Margin="0,0,12,0" />
                                <Label Grid.Column="2" Text="{Binding TotalItemsPrice, StringFormat='{0:0.00}'}" TextColor="{StaticResource Coral}" FontAttributes="Bold" FontSize="14" />
                            </Grid>
                            <Label Text="{Binding Comment}" IsVisible="{Binding HasComment}" TextColor="{StaticResource TextOnCardMuted}" FontSize="12.5" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="2"
            x:Name="ContinuePaymentButton"
            Text="Continue to Payment"
            BackgroundColor="{StaticResource Yellow}"
            TextColor="{StaticResource TextOnCard}"
            Clicked="OnContinuePaymentClicked"
            HeightRequest="52"
            FontSize="16"
            IsVisible="False" />

        <Button
            Grid.Row="3"
            x:Name="CancelButton"
            Text="Cancel Order"
            BackgroundColor="{StaticResource ChipInactive}"
            TextColor="{StaticResource Coral}"
            Clicked="OnCancelClicked"
            IsVisible="False" />

    </Grid>

</ContentPage>
