<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Mobile.LoginPage"
             Title="POS-MB">

    <ScrollView>
        <VerticalStackLayout Padding="30,60,30,30" Spacing="16">

            <Label
                Text="POS-MB"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                x:Name="StatusLabel"
                TextColor="Gray"
                HorizontalOptions="Center"
                IsVisible="False" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False" />

            <VerticalStackLayout x:Name="FormLayout" Spacing="16">

                <Label
                    x:Name="ModeLabel"
                    Text="Log in to your account"
                    FontSize="16"
                    TextColor="Gray"
                    HorizontalOptions="Center"
                    Margin="0,0,0,20" />

                <Entry
                    x:Name="EmailEntry"
                    Placeholder="Email"
                    Keyboard="Email" />

                <Entry
                    x:Name="PasswordEntry"
                    Placeholder="Password"
                    IsPassword="True" />

                <Button
                    x:Name="ForgotPasswordButton"
                    Text="Forgot password?"
                    Clicked="OnForgotPasswordClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontSize="13"
                    HorizontalOptions="End"
                    Padding="0" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="Red"
                    IsVisible="False" />

                <Button
                    x:Name="PrimaryButton"
                    Text="Log In"
                    Clicked="OnPrimaryButtonClicked"
                    Margin="0,10,0,0" />

                <Button
                    x:Name="ToggleModeButton"
                    Text="Don't have an account? Sign up"
                    Clicked="OnToggleModeClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
