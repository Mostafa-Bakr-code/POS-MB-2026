<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Mobile.LoginPage"
             Title="POS-MB">

    <ScrollView>
        <VerticalStackLayout Padding="30,70,30,30" Spacing="16">

            <Label
                Text="POS-MB"
                FontSize="36"
                FontAttributes="Bold"
                TextColor="{StaticResource Yellow}"
                HorizontalOptions="Center" />

            <Label
                Text="Dimashk Street"
                FontSize="14"
                TextColor="{StaticResource TextOnDarkMuted}"
                HorizontalOptions="Center"
                Margin="0,-10,0,0" />

            <Label
                x:Name="StatusLabel"
                TextColor="{StaticResource TextOnDarkMuted}"
                HorizontalOptions="Center"
                IsVisible="False" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False" />

            <VerticalStackLayout x:Name="FormLayout" Spacing="16" Margin="0,20,0,0">

                <Label
                    x:Name="ModeLabel"
                    Text="Log in to your account"
                    FontSize="16"
                    TextColor="{StaticResource TextOnDarkMuted}"
                    HorizontalOptions="Center"
                    Margin="0,0,0,10" />

                <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="4">
                    <Entry
                        x:Name="EmailEntry"
                        Placeholder="Email"
                        Keyboard="Email" />
                </Border>

                <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="4">
                    <Entry
                        x:Name="PasswordEntry"
                        Placeholder="Password"
                        IsPassword="True" />
                </Border>

                <Button
                    x:Name="ForgotPasswordButton"
                    Text="Forgot password?"
                    Clicked="OnForgotPasswordClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Yellow}"
                    FontSize="13"
                    HorizontalOptions="End"
                    Padding="0"
                    MinimumHeightRequest="0" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="{StaticResource ErrorRed}"
                    IsVisible="False" />

                <Button
                    x:Name="PrimaryButton"
                    Text="Log In"
                    Clicked="OnPrimaryButtonClicked"
                    HeightRequest="52"
                    FontSize="16"
                    Margin="0,10,0,0" />

                <Button
                    x:Name="ToggleModeButton"
                    Text="Don't have an account? Sign up"
                    Clicked="OnToggleModeClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextOnDark}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
