<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_MB.Mobile.ForgotPasswordPage"
             Title="Forgot Password">

    <ScrollView>
        <VerticalStackLayout Padding="30,40,30,30" Spacing="16">

            <Label
                Text="Enter your account email and we'll send you a code to reset your password."
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email"
                Keyboard="Email" />

            <Label
                x:Name="ErrorLabel"
                TextColor="Red"
                IsVisible="False" />

            <Button
                x:Name="SendCodeButton"
                Text="Send Reset Code"
                Clicked="OnSendCodeClicked"
                Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
